{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.scripts.json",
    "test:frontend": "npm run test:frontend:pure && npm run test:frontend:integration",
    "test:frontend:pure": "tsx --test tests/frontend/*.test.ts",
    "test:frontend:integration": "vitest run tests/frontend/batch4-organization-context.integration.test.tsx tests/frontend/batch5d-collaboration.integration.test.tsx tests/frontend/batch5e-auth-containment.integration.test.tsx tests/frontend/batch5e-auth-context-hardening.integration.test.tsx tests/frontend/batch5e-password-recovery.integration.test.tsx tests/frontend/batch5e-supabase-recovery-provenance.integration.test.tsx",
    "test:provisioning": "tsx --test scripts/provisioning/tenant-provisioning.test.ts scripts/provisioning/member-provisioning.test.ts",
    "test:repair": "tsx --test scripts/repairs/batch5a-domain-drift-repair.test.ts",
    "check:tenant-queries": "node --experimental-strip-types scripts/check-domain-query-baseline.ts",
    "provision:purplelok": "tsx scripts/provision-purplelok.ts",
    "provision:purplelok-demo": "tsx scripts/provision-purplelok-demo.ts",
    "provision:member": "tsx scripts/provision-member.ts",
    "repair:batch5a-domain-drift": "tsx scripts/repair-batch5a-domain-drift.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
